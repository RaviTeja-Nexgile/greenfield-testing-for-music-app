# Server
PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-in-production

# Database (PostgreSQL) — used by later tasks; local dev uses a file-backed store
DATABASE_URL=postgres://resonance:resonance@localhost:5432/resonance

# AWS S3 (audio + cover storage) — configured only in production
AWS_REGION=eu-west-1
AWS_S3_BUCKET=resonance-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Web (Vite dev server port)
# VITE_API_URL=http://localhost:3000
